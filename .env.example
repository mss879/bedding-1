# Supabase — leave unset to run on the built-in seed catalog.
# After running the migrations in supabase/migrations/ (0001 then 0002), fill
# these in and the site switches to the database automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Settings → API — keep secret, server-only). Required for
# the /admin dashboard to read orders and manage products/collections.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin dashboard login.
ADMIN_PASSWORD=

# WhatsApp number for inquiries/orders: country code + number, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=94771852522

# Canonical URL used for SEO (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.ivoryhomez.com

# Resend (Email Service)
RESEND_API_KEY=


# ── Paycorp card payments (Commercial Bank of Ceylon IPG) ───────────────────
# Issued by the bank's electronic banking unit. Server-only — do NOT prefix any
# of these with NEXT_PUBLIC_. Leave them blank and the card option is simply
# hidden at checkout; cash on delivery and bank transfer keep working.
PAYCORP_ENDPOINT=https://paycorp-cbc.prod.aws.paycorp.lk/rest/service/proxy
PAYCORP_CLIENT_ID=
PAYCORP_AUTH_TOKEN=
PAYCORP_HMAC_SECRET=

# Currency the merchant profile settles in. The bank labels the issued
# credentials "Client ID 01 (LKR)", but the profile rejects LKR outright
# ("Invalid currency code") and accepts USD — which is what the catalogue is
# priced in. Trust the gateway, not the label.
PAYCORP_CURRENCY=USD
# USD → PAYCORP_CURRENCY rate, kept for a possible second profile in another
# currency. Ignored while PAYCORP_CURRENCY=USD.
PAYCORP_USD_RATE=1
# Dry run: Paycorp validates the request without moving money. Never "true" in
# production, and only ever the exact string "true" turns it on.
PAYCORP_VALIDATE_ONLY=false

# NOTE: NEXT_PUBLIC_SITE_URL above is what the gateway return URL is built
# from. The return leg is a redirect in the shopper's own browser, not a
# server-to-server call, so http://localhost:3000 works for local testing. Set
# it to the real public origin before deploying.
